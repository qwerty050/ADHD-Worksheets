# --- LLM provider (worksheet generation + KB tagging) ---
# One of: ollama | anthropic | openai | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE=http://localhost:11434

# Provider API keys (needed only when LLM_PROVIDER selects that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MAX_TOKENS=16384

# NOTE: embeddings always run locally via Ollama (EMBED_MODEL below),
# regardless of LLM_PROVIDER.

# --- Extraction pipeline ---
MODEL_EXTRACTION=gpt-oss:120b-cloud
MODEL_PEDAGOGY=gpt-oss:120b-cloud

# --- Generation pipeline (two calls per section) ---
MODEL_WRITER=gpt-oss:120b-cloud
MODEL_QUESTIONS=gpt-oss:120b-cloud

# --- Memory module (cmkb) ---
EMBED_MODEL=nomic-embed-text
TAG_MODEL=gemma3n:e4b
PAGEINDEX_MODEL=gemma3n:e4b
