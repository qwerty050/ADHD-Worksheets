# --- LLM provider (worksheet generation + KB tagging) ---
# One of: ollama | anthropic | openai | gemini
# With anthropic/openai/gemini, set ALL of MODEL_*, TAG_MODEL and
# PAGEINDEX_MODEL below to model names that provider accepts.
LLM_PROVIDER=ollama
OLLAMA_BASE=http://localhost:11434

# Provider API keys (needed only when LLM_PROVIDER selects that provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Output-token limit for Anthropic calls that set no limit of their own
# (KB tagging, aliases, PageIndex traversal). Not saved by the web Config page.
ANTHROPIC_MAX_TOKENS=16384

# NOTE: embeddings always run locally via Ollama (EMBED_MODEL below),
# regardless of LLM_PROVIDER.

# --- Extraction pipeline ---
# gpt-oss:120b-cloud is an Ollama cloud model: run `ollama signin` and
# `ollama pull gpt-oss:120b-cloud` first, or use a local model instead.
MODEL_EXTRACTION=gpt-oss:120b-cloud
MODEL_PEDAGOGY=gpt-oss:120b-cloud

# --- Generation pipeline (two calls per section) ---
MODEL_WRITER=gpt-oss:120b-cloud
MODEL_QUESTIONS=gpt-oss:120b-cloud

# --- Memory module (cmkb) ---
EMBED_MODEL=nomic-embed-text
TAG_MODEL=gemma3n:e4b
PAGEINDEX_MODEL=gemma3n:e4b

# --- Optional / rarely needed (defaults shown) ---
# Generate endpoint used by the shared Ollama client.
# OLLAMA_API_URL=http://localhost:11434/api/generate
# PageIndex tree building (`ingest pdf --mode page_index`) with LLM_PROVIDER=openai
# reads its key from CHATGPT_API_KEY (legacy alias: Ollama_API_KEY), not OPENAI_API_KEY.
# CHATGPT_API_KEY=
# Ollama_API_KEY=
# PageIndex tree building with LLM_PROVIDER=ollama: replaces PAGEINDEX_MODEL when that
# name contains "gpt-" or starts with "text-" (fallback: mistral24b-16k).
# OLLAMA_MODEL=

# The web app's API base URL is set separately, in web/.env.local:
# VITE_API_URL=http://localhost:8000/api
